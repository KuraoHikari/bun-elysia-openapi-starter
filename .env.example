# Server
PORT=3001

# MySQL connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:root@localhost:3306/mydb

# Better Auth secret — MUST be a long random string in production.
# Generate with: openssl rand -base64 48
# DO NOT use the placeholder value in production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Better Auth base URL (auto-detected from PORT if not set)
# BETTER_AUTH_URL=http://localhost:3001
